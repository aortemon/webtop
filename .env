# Enable use of Escape sequences ("\033[..." ) for colored output
# of server logs (1 - enable, other - disable)
ENABLE_COLORED_OUTPUT=1

# Enable debug info printing (1 - enable, other - disable)
ENABLE_DEBUG_INFO=0

# The port to start the server on
LISTEN_PORT=8080

# Relative path to directory containing static frontend files
STATIC_DIR=static/

# Common statistics update period (in seconds)
COMMON_STATS_UPDATE_RATE=1

# Process data update period (in seconds)
PROCS_STATS_UPDATE_RATE=1